{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".tanstack/**"]
    },
    "validate": {
      "dependsOn": ["^build"],
      "inputs": [
        "scripts/check-content.mjs",
        "scripts/gen-reference.mjs",
        "src/content/**"
      ],
      "outputs": []
    }
  }
}
